              <i id="eye-icon" class="fa-regular fa-eye-slash text-xs"></i>
            </button>
          </div>
        </div>

        <!-- Remember Me Checkbox -->
        <div class="flex items-center pt-0.5">
          <input 
            id="remember" 
            type="checkbox" 
            class="w-3.5 h-3.5 border-gray-300 rounded focus:ring-emerald-500 accent-emerald-600 cursor-pointer"
          />
          <label for="remember" class="ml-2 text-[10px] text-gray-600 cursor-pointer select-none font-normal">
