            type="email" 
            placeholder="Enter your email" 
            class="w-full px-3.5 py-2.5 text-xs bg-gray-200/60 border border-white/30 rounded-xl focus:outline-none focus:bg-white/90 focus:border-orange-500 transition placeholder-gray-500 text-gray-800 font-normal"
          />
        </div>

        <!-- Password Input -->
        <div>
          <label class="block text-[11px] font-medium text-gray-800 mb-1.5">Password</label>
          <div class="relative">
            <input 
              id="password"
              type="password" 
              placeholder="Enter your password" 
              class="w-full px-3.5 py-2.5 text-xs bg-gray-200/60 border border-white/30 rounded-xl focus:outline-none focus:bg-white/90 focus:border-orange-500 transition placeholder-gray-500 text-gray-800 font-normal pr-10"
