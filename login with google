          <i class="fa-brands fa-facebook text-blue-600 text-xs"></i>
          Facebook
        </button>
      </div>

    </div>
  </div>

  <!-- Modal Pop-up Google Auth Custom -->
  <div id="google-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 transition-all duration-300">
    <div class="bg-white rounded-3xl p-6 lg:p-8 w-full max-w-md shadow-2xl relative">
      
      <!-- Tombol Close (X) -->
      <button 
        onclick="closeGoogleModal()"
        class="absolute top-4 right-5 text-gray-400 hover:text-gray-700 text-lg focus:outline-none">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <!-- Konten Modal Putih Custom -->
      <div class="text-center space-y-4">
        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto text-xl text-gray-700 shadow-sm">
          <i class="fa-brands fa-google text-red-500"></i>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-gray-800">Sign in with Google</h3>
          <p class="text-xs text-gray-500 mt-1">Lanjutkan login ke <b>GO TRAVEL</b></p>
        </div>

        <!-- Tombol Login Google Asli di Dalam Modal -->
        <div class="py-3 flex justify-center">
          <div id="googleBtnModal"></div>
        </div>

        <p class="text-[10px] text-gray-400 pt-1 leading-relaxed">
          Untuk melanjutkan, Google akan membagikan nama, alamat email, dan foto profil Anda dengan GO TRAVEL.
        </p>
      </div>

    </div>
  </div>

  <!-- JavaScript Toggle, Modal, & Google Auth -->
  <script>
    function togglePassword() {
      const passwordInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eye-icon');
      
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.classList.remove('fa-eye-slash');
        eyeIcon.classList.add('fa-eye');
      } else {
        passwordInput.type = 'password';
        eyeIcon.classList.remove('fa-eye');
        eyeIcon.classList.add('fa-eye-slash');
      }
    }

    // Fungsi Buka & Tutup Modal Putih
    function openGoogleModal() {
      document.getElementById('google-modal').classList.remove('hidden');
    }

    function closeGoogleModal() {
      document.getElementById('google-modal').classList.add('hidden');
    }

    window.onclick = function(event) {
      const modal = document.getElementById('google-modal');
      if (event.target === modal) {
        closeGoogleModal();
      }
    }

    // Inisialisasi Google Sign-In di dalam Modal Putih Custom
    window.onload = function () {
      google.accounts.id.initialize({
        client_id: "997677889943-rmdi2le79udl6mijar561sn9l4rtjstn.apps.googleusercontent.com",
        callback: handleCredentialResponse
      });

      // Render Tombol Google ke elemen di dalam Modal
      google.accounts.id.renderButton(
        document.getElementById("googleBtnModal"),
        { 
          theme: "outline", 
          size: "large",
          width: 280,
          text: "continue_with",
          shape: "pill"
        } 
      );
    };

    // Callback setelah user berhasil Login
    function handleCredentialResponse(response) {
      const responsePayload = parseJwt(response.credential);
      console.log("Data User Google:", responsePayload);
      
      closeGoogleModal();
      alert(`Selamat datang di GO TRAVEL, ${responsePayload.name}!`);
    }

    // Helper Decode Token JWT Google
    function parseJwt(token) {
      const base64Url = token.split('.')[1];
      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
      const jsonPayload = decodeURIComponent(
        window.atob(base64)
          .split('')
          .map(function (c) {
            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
          })
          .join('')
      );

      return JSON.parse(jsonPayload);
    }
  </script>
</body>
</html>




