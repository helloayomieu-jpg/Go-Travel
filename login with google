  <title>Login - GO TRAVEL</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts (Inter) -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <!-- SDK Google Sign-In Resmi -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>

  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden !important; /* Mencegah scrollbar */
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
  </style>
</head>
<body class="bg-cover bg-center bg-fixed flex items-center justify-center p-4 relative" 
      style="background-image: url('img/gunung bromo.png');">
  
  <!-- Overlay Latar Belakang Luar -->
  <div class="absolute inset-0 bg-black/15 pointer-events-none"></div>

  <!-- Main Card Container -->
  <div class="relative z-10 w-full max-w-5xl h-full max-h-[92vh] bg-white/75 backdrop-blur-md rounded-[34px] p-1.5 border border-white/45 shadow-2xl grid grid-cols-1 md:grid-cols-2 gap-4 overflow-hidden">
    
    <!-- Left Section: Image Card -->
    <div class="relative rounded-[28px] overflow-hidden h-full bg-cover bg-center flex flex-col justify-end p-6 lg:p-8 shadow-inner" 
         style="background-image: url('img/gunung bromo.png');">

      <!-- Gradient Overlay Halus -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
      
      <div class="relative z-10 text-white space-y-2">
        <h1 class="text-4xl lg:text-5xl font-extralight leading-[1.1] tracking-wide text-white drop-shadow-sm">
          Explore More<br />
          <span class="font-light">Travel Better</span>
        </h1>
        <p class="text-[11px] text-gray-100 font-light max-w-xs leading-relaxed pt-1 drop-shadow-sm">
          Setiap perjalanan dimulai dengan satu langkah. Temukan destinasi impianmu di sini.
        </p>
      </div>
    </div>

    <!-- Right Section: Login Form -->
    <div class="flex flex-col justify-center items-center px-6 lg:px-10 py-4 text-gray-700 w-full h-full my-auto overflow-hidden">
      
      <!-- Title & Subtitle -->
      <div class="text-center mb-5 -mt-1 w-full max-w-[360px]">
        <h2 class="text-[22px] lg:text-2xl font-light text-gray-900 tracking-normal whitespace-nowrap">
          Welcome to GO TRAVEL
        </h2>
        <p class="text-[11px] text-gray-600 mt-1 leading-relaxed font-light">
          Buat akun dan temukan berbagai paket wisata<br />
          terbaik untuk perjalanan impianmu.
        </p>
      </div>

      <!-- Tab Switcher -->
      <div class="bg-[#c2c5cc] p-0.5 rounded-full flex items-center mb-5 w-full max-w-[360px]">
        <a href="login.html" class="w-1/2 py-2 text-xs font-semibold text-gray-800 bg-white rounded-full border border-white/40 shadow-sm transition text-center block">
          Login
        </a>
        <a href="register.html" class="w-1/2 py-2 text-xs font-normal text-gray-600 hover:text-gray-900 transition text-center block">
          Register
        </a>
      </div>

      <!-- Form Inputs -->
      <form class="space-y-3.5 w-full max-w-[360px]" onsubmit="event.preventDefault();">
        <!-- Email Input -->
        <div>
          <label class="block text-[11px] font-medium text-gray-800 mb-1.5">Email</label>
