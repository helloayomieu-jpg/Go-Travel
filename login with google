  <script>
    function navigateTo(page) {
      const homePage = document.getElementById('home-page');
      const paketPage = document.getElementById('paket-page');
      const detailJogjaPage = document.getElementById('detail-jogja-page');
      const detailBaliPage = document.getElementById('detail-bali-page');
      
      const navHome = document.getElementById('nav-home');
      const navPaket = document.getElementById('nav-paket');

      // Sembunyikan semua halaman terlebih dahulu
      homePage.classList.add('hidden');
      paketPage.classList.add('hidden');
      if (detailJogjaPage) detailJogjaPage.classList.add('hidden');
      if (detailBaliPage) detailBaliPage.classList.add('hidden');

      if (page === 'home') {
        homePage.classList.remove('hidden');
        navHome.classusernam= "bg-amber-100/80 text-amber-800 px-5 py-1.5 rounded-full shadow-sm transition";
        navPaket.classusernam= "hover:bg-gray-100 px-4 py-1.5 rounded-full transition";
      } else if (page === 'paket') {
        paketPage.classList.remove('hidden');
        navPaket.classusernam= "bg-amber-100/80 text-amber-800 px-5 py-1.5 rounded-full shadow-sm transition";
        navHome.classusernam= "hover:bg-gray-100 px-4 py-1.5 rounded-full transition";
      } else if (page === 'detail-jogja') {
        detailJogjaPage.classList.remove('hidden');
        navPaket.classusernam= "bg-amber-100/80 text-amber-800 px-5 py-1.5 rounded-full shadow-sm transition";
        navHome.classusernam= "hover:bg-gray-100 px-4 py-1.5 rounded-full transition";
      } else if (page === 'detail-bali') {
        detailBaliPage.classList.remove('hidden');
        navPaket.classusernam= "bg-amber-100/80 text-amber-800 px-5 py-1.5 rounded-full shadow-sm transition";
        navHome.classusernam= "hover:bg-gray-100 px-4 py-1.5 rounded-full transition";
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleDropdown() {
      const dropdown = document.getElementById('filterDropdown');
      dropdown.classList.toggle('hidden');
    }

    window.addEventListener('click', function(e) {
      const btn = document.getElementById('dropdownBtn');
      const dropdown = document.getElementById('filterDropdown');
      if (btn && dropdown && !btn.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });

    document.addEventListener("DOMContentLoaded", function() {
      navigateTo('home');
    });
  </script>
